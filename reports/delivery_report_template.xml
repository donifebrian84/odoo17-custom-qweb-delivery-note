<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_note_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 13px;">
                        
                        <!-- Header / Judul Dokumen -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h2 class="fw-bold text-primary">SURAT JALAN</h2>
                                <span class="badge bg-secondary" t-field="o.state"/>
                            </div>
                            <div class="col-6 text-end">
                                <h4 t-field="o.name" class="fw-bold"/>
                                <p class="text-muted mb-0">Tgl Pengiriman: <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/></p>
                            </div>
                        </div>

                        <hr class="my-3"/>

                        <!-- Informasi Penerima & Pengirim -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Tujuan / Pelanggan:</strong>
                                <address t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True}' class="mt-1"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Dokumen Referensi:</strong>
                                <p class="mb-0" t-field="o.origin"/>
                                <!-- SCRIPT BARU SAFE CHECK -->
<strong>Carrier / Kurir:</strong>
<p class="mb-0">
    <t t-if="'carrier_id' in o and o.carrier_id">
        <span t-field="o.carrier_id.name"/>
    </t>
    <t t-else="">
        <span class="text-muted">- (Internal Delivery)</span>
    </t>
</p>
                            </div>
                        </div>

                        <!-- Tabel Detail Barang -->
                        <table class="table table-sm table-striped border mt-3">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 5%;">#</th>
                                    <th style="width: 55%;">Deskripsi Produk</th>
                                    <th class="text-end" style="width: 20%;">Jumlah Dipesan</th>
                                    <th class="text-end" style="width: 20%;">Jumlah Dikirim</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="counter" t-value="0"/>
                                <t t-foreach="o.move_ids_without_package" t-as="line">
                                    <t t-set="counter" t-value="counter + 1"/>
                                    <tr>
                                        <td><span t-esc="counter"/></td>
                                        <td>
                                            <span t-field="line.product_id.display_name"/><br/>
                                            <small class="text-muted" t-field="line.name"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.product_uom_qty"/> <span t-field="line.product_uom.name"/>
                                        </td>
                                        <td class="text-end">
                                            <!-- Kondisional XML: Cek Status Pengiriman -->
                                            <t t-if="o.state == 'done'">
                                                <span t-field="line.quantity"/> <span t-field="line.product_uom.name"/>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Area Tanda Tangan & Konfirmasi -->
                        <div class="row mt-5 pt-4 text-center">
                            <div class="col-4">
                                <p>Pengirim,</p>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4">
                                <p>Sopir / Kurir,</p>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                            <div class="col-4">
                                <p>Penerima,</p>
                                <br/><br/><br/>
                                <p>____________________</p>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>